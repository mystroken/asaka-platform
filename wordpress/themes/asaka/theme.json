    "shadow": {
      "defaultPresets": false
    },
    "custom": {
      "radius": {
        "sm": "6px",
        "md": "8px",
        "lg": "12px",
        "pill": "999px"
      },
      "shadow": {
        "card": "0 8px 24px rgba(23, 32, 51, 0.10)"
      },
      "lineHeight": {
        "display": "47px",
        "price": "43px",
        "title-1": "41px",
        "title-2": "33px",
        "title-3": "28px",
        "label": "20px",
        "lead": "27px",
        "body-lg": "26px",
        "body": "23px",
        "body-sm": "21px",
        "caption": "20px",
        "overline": "18px"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--body)",
      "lineHeight": "1.534"
    },
    "spacing": {
      "blockGap": "16px",
      "padding": {
        "left": "clamp(16px, 4vw, 32px)",
        "right": "clamp(16px, 4vw, 32px)",
        "top": "0",
        "bottom": "0"
      }
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--primary-strong)"
          },
          "typography": {
            "textDecoration": "underline"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--ink)"
        },
        "typography": {
          "fontWeight": "600"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--display)",
          "lineHeight": "1.175",
          "letterSpacing": "-0.8px"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--title-2)",
          "lineHeight": "1.27",
          "letterSpacing": "-0.4px"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--title-3)",
          "lineHeight": "1.4"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text": "var(--wp--preset--color--ink)"
        },
        "border": {
          "radius": "8px"
        },
        "typography": {
          "fontWeight": "600",
          "fontSize": "15px",
          "lineHeight": "20px"
        },
        "spacing": {
          "padding": {
            "top": "12px",
            "bottom": "12px",
            "left": "20px",
            "right": "20px"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "En-tête",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Pied de page",
      "area": "footer"
    }
  ]
}
