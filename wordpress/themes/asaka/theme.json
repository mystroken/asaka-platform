      "defaultFontSizes": false,
      "fluid": false,
      "customFontSize": false,
      "dropCap": false,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "General Sans",
          "fontFamily": "\"General Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "General Sans",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/GeneralSans-Regular.woff2"
              ]
            },
            {
              "fontFamily": "General Sans",
              "fontWeight": "500",
              "fontStyle": "normal",
