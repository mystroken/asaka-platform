# Copier en .env puis ajuster. Valeurs de développement uniquement.

# Ports locaux
WP_PORT=8080
MOODLE_PORT=8081
MAILPIT_PORT=8025

# URLs publiques (doivent correspondre aux ports ci-dessus)
WP_URL=http://localhost:8080
MOODLE_URL=http://localhost:8081

# WordPress (MariaDB : WordPress ne supporte pas PostgreSQL)
WP_DB_NAME=wordpress
WP_DB_USER=wordpress
WP_DB_PASSWORD=wordpress
WP_DB_ROOT_PASSWORD=root
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=Asaka-dev-2026
WP_ADMIN_EMAIL=dev@asaka.local

# Moodle (PostgreSQL 16, requis par Moodle 5.2)
MOODLE_BRANCH=MOODLE_502_STABLE
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=moodle
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=Asaka-dev-2026
MOODLE_ADMIN_EMAIL=dev@asaka.local
